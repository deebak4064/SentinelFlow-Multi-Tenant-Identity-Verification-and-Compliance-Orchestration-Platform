# Copy to .env and fill in. Never commit .env.
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# 32 random bytes, urlsafe base64. Generate with:
#   python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Required when SF_ENV=production. Changing it makes existing encrypted PII unreadable.
SF_FIELD_ENCRYPTION_KEY=

SF_ENV=development
# Set to true when served over HTTPS (adds Secure cookies and HSTS).
SF_COOKIE_SECURE=false
SF_RATE_LIMIT_PER_MINUTE=600
WORKER_REPLICAS=1

# Optional external LLM for the analyst assistant. Each organization must also opt in under
# Settings. Without a key the assistant uses its deterministic summary.
SF_LLM_API_KEY=
